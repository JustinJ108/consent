# Hosted Postgres connection string (e.g. Neon). When set, the API uses this
# instead of the embedded PGlite database. Required when deploying to Vercel.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Directory for the embedded Postgres (PGlite) data files. Only used when
# DATABASE_URL is not set (local development).
PGLITE_DIR=./.data/pglite

# Change this before deploying anywhere real.
JWT_SECRET=dev-secret-change-me

PORT=4000

# Origins allowed to call the API directly (comma-separated).
CORS_ORIGIN=http://localhost:3000
